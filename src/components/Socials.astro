---
import { site } from '../site';

interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---

<ul class:list={['socials', cls]}>
  <li>
    <a href={site.links.linkedin} rel="me noopener" target="_blank">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="4" stroke="currentColor" stroke-width="1.6"></rect>
        <path d="M8 10.5V16M8 7.6v.1M11.5 16v-5.5M11.5 13c0-1.6 1.1-2.6 2.5-2.6s2.5 1 2.5 2.6V16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
      LinkedIn
    </a>
  </li>
  <li>
    <a href={site.links.github} rel="me noopener" target="_blank">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M9 19c-4 1.3-4-2-5.6-2.4M14.6 21v-3.2c0-1 .1-1.5-.5-2.1 2.6-.3 5.3-1.3 5.3-5.8 0-1.2-.4-2.2-1.2-3 .4-1 .3-2.2-.1-3.2 0 0-1-.3-3.2 1.2a11 11 0 0 0-5.8 0C6.9 3.4 5.9 3.7 5.9 3.7c-.4 1-.5 2.2-.1 3.2-.8.8-1.2 1.8-1.2 3 0 4.5 2.7 5.5 5.3 5.8-.6.6-.6 1.2-.5 2.1V21"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      GitHub
    </a>
  </li>
  <li>
    <a href={site.links.medium} rel="me noopener" target="_blank">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <circle cx="7.2" cy="12" r="5"></circle>
        <ellipse cx="15.6" cy="12" rx="2.6" ry="4.8"></ellipse>
        <ellipse cx="20.6" cy="12" rx="1" ry="4.3"></ellipse>
      </svg>
      Medium
    </a>
  </li>
  <li>
    <a href={`mailto:${site.email}`}>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="3" stroke="currentColor" stroke-width="1.6"></rect>
        <path d="M4 7.5l8 5.5 8-5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      Email
    </a>
  </li>
</ul>
