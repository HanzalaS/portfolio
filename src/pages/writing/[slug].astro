---
import { render } from 'astro:content';
import Layout from '../../layouts/Cinematic.astro';
import { articles, longDate, shortDate, minutes, type Article } from '../../writing';
import { base } from '../../site';

export async function getStaticPaths() {
  const all = await articles();
  return all.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, more: all.filter((a) => a.id !== entry.id) },
  }));
}

interface Props {
  entry: Article;
  more: Article[];
}

const { entry, more } = Astro.props;
const { title, excerpt, date, origin } = entry.data;
const { Content } = await render(entry);
---

<Layout title={title} description={excerpt} article={{ published: date }}>
  <article class="article" aria-labelledby="a-h">
    <header class="a-head">
      <a class="back" href={`${base}writing/`}><span aria-hidden="true">←</span> All writing</a>
      <p class="a-meta">
        <time datetime={date.toISOString().slice(0, 10)}>{longDate(date)}</time>
        <span>{minutes(entry)} min read</span>
      </p>
      <h1 id="a-h">{title}</h1>
      <p class="a-excerpt">{excerpt}</p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="a-foot">
      <p class="origin">
        First published on <a href={origin.url} rel="noopener" target="_blank">{origin.name}</a>.
      </p>
      {
        more.length > 0 && (
          <nav class="more" aria-labelledby="more-h">
            <p class="label" id="more-h">Keep reading</p>
            <ul>
              {more.map((a) => (
                <li>
                  <a href={`${base}writing/${a.id}/`}>
                    <span class="m-date">{shortDate(a.data.date)}</span>
                    <span class="m-title">{a.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </footer>
  </article>
</Layout>
